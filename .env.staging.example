# ==============================================================================
# klasio - Staging Environment Configuration Template
# Copy this file to .env.staging and populate with secure, generated values.
# ==============================================================================

# Application Environment & Debug Settings
# In staging/production, DEBUG must be false and strong non-default keys are enforced.
ENVIRONMENT=staging
DEBUG=false
APP_NAME=Automated Student Attendance API (Staging)

# PostgreSQL Database Credentials & Internal Networking
# Use a strong, random password. In staging, the DB is internal to the container network.
POSTGRES_USER=atten_user
POSTGRES_PASSWORD=replace_with_generated_db_password_min_24_chars
POSTGRES_DB=atten_staging_db
POSTGRES_PORT=5432

# SQLAlchemy AsyncPG Connection String (points to internal 'db' container service)
DATABASE_URL=postgresql+asyncpg://atten_user:replace_with_generated_db_password_min_24_chars@db:5432/atten_staging_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# Security & JWT Authentication
# Generate a cryptographically secure 256-bit secret key using: openssl rand -hex 32
# Must be at least 32 characters and must NOT contain the word 'insecure'.
SECRET_KEY=replace_with_secure_random_key_from_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated list or JSON array of allowed origins)
# For mobile app testing via Metro or staging web console:
CORS_ORIGINS=https://staging.attendly.institution.edu,http://localhost:8081

# Institutional Domain Policy
ATTENDANCE_CORRECTION_WINDOW_DAYS=7
