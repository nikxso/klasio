<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: Trust system CAs and user-installed CAs (for self-signed staging certs) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Staging & Development domain configuration: Allow cleartext HTTP for local IP and staging domains -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">staging.local</domain>
    </domain-config>
</network-security-config>
